+# ---------------------------------------------------------------- 16 พ.ย. 2569: เสียงไทยกับทุกภาษา (Google)
+def test_google_uses_thai_voice_for_english_text(monkeypatch, tmp_path):
+    """ข้อความอังกฤษล้วน lang=en → ส่ง tl=th ให้ Google (เสียงเดียวกับภาษาไทย) · ใช้ google_stream ตัวจริงกับ httpx จำลอง"""
+    import httpx
+
+    sent = []
+
+    class Resp:
+        content = b"MP3"
+        headers = {"content-type": "audio/mpeg"}
+
+        def raise_for_status(self):
+            return None
+
+    class Client:
+        def __init__(self, *a, **k):
+            pass
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *a):
+            return False
+
+        async def get(self, url, params=None):
+            sent.append(dict(params))
+            return Resp()
+
+    monkeypatch.setattr(httpx, "AsyncClient", Client)
+    monkeypatch.setattr(tts, "CACHE_DIR", tmp_path)
+    monkeypatch.setattr(tts, "_g_state", {"fail_until": 0.0, "last_error": ""})
+    monkeypatch.setattr(tts, "record_event", lambda *a, **k: None)
+
+    async def run(text, lang):
+        return b"".join([c async for c in tts.google_stream(text, lang)])
+
+    assert asyncio.run(run("Hello Welcome to VORA", "en")) == b"MP3"
+    assert asyncio.run(run("สวัสดีค่ะ", "th")) == b"MP3"
+    assert [p["tl"] for p in sent] == ["th", "th"]
+    assert tts._gpath("Hello", "en") != tts._gpath("Hello", "th")      # แคชยังแยกตามภาษาของคำตอบ
