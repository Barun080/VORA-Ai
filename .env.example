# ===== การตั้งค่า VORA (คัดลอกไฟล์นี้เป็น .env แล้วแก้ไข) =====

# ข้อมูลระบบ
VORA_SCHOOL_CODE=demo-college
VORA_PORT=8000
# URL ที่มือถือใช้เข้า (ถ้าเว้นว่าง ระบบหา IP ของเครื่องให้อัตโนมัติ)
VORA_PUBLIC_URL=
# บัญชีผู้ดูแลเริ่มต้น (ใช้ตอนสร้างฐานข้อมูลครั้งแรกเท่านั้น เปลี่ยนรหัสผ่านทันทีหลังเข้าระบบ)
VORA_ADMIN_USER=admin
VORA_ADMIN_PASSWORD=vora1234

# ===== ฐานข้อมูล =====
# แนะนำ PostgreSQL — รัน setup_postgres.bat เพื่อติดตั้ง สร้างฐานข้อมูล และเติมบรรทัดนี้ให้อัตโนมัติ
# ถ้าไม่ตั้งค่า ระบบใช้ SQLite ที่ data/vora.db (ทำงานได้ทันทีไม่ต้องติดตั้งอะไรเพิ่ม)
# VORA_DATABASE_URL=postgresql+psycopg://vora:รหัสผ่าน@localhost:5432/vora
# ฐานข้อมูลสำหรับชุดทดสอบ (test.bat) ชื่อต้องมีคำว่า test เพราะชุดทดสอบจะล้างข้อมูลในฐานนี้
# VORA_TEST_DATABASE_URL=postgresql+psycopg://vora:รหัสผ่าน@localhost:5432/vora_test

# ===== AI ภาษาธรรมชาติ (ไม่บังคับ) =====
# none = ตอบจากฐานความรู้โดยตรง ทำงานออฟไลน์ได้ 100%
# gemini | openai | anthropic | typhoon | ollama = ใช้ LLM เรียบเรียงคำตอบจากฐานความรู้ให้เป็นธรรมชาติขึ้น
VORA_LLM_PROVIDER=none
VORA_LLM_API_KEY=
# เว้นว่างเพื่อใช้ค่าเริ่มต้นของผู้ให้บริการ
VORA_LLM_MODEL=
VORA_LLM_BASE_URL=
# (Phase 6 · 6E-1) timeout ของผู้ให้บริการหลัก ≈4 วิ
VORA_LLM_TIMEOUT=4
# (Phase 6) ผู้ให้บริการสำรองเมื่อผู้ให้บริการหลักล่ม/ไม่มีอินเทอร์เน็ต เช่น ollama ในเครื่อง · เว้นว่าง = ไม่ใช้ (เหมือนเดิม)
VORA_LLM_FALLBACK_PROVIDER=
VORA_LLM_FALLBACK_API_KEY=
VORA_LLM_FALLBACK_MODEL=
VORA_LLM_FALLBACK_BASE_URL=
# ผู้ให้บริการสำรองใช้ได้ไม่เกินเวลาที่เหลือของงบรวม (VORA_AI_BUDGET_S)
VORA_LLM_FALLBACK_TIMEOUT=8
# งบเวลารวมต่อคำถามก่อนตอบจากฐานความรู้ (วินาที) — 6E-1: deadline ร่วมของทุกการเรียก AI ในคำถามเดียว รวมเวลารอคิว
# 0 = ไม่จำกัดเพิ่ม (พฤติกรรมก่อน 6E)
VORA_AI_BUDGET_S=8
# (6E-1) จำนวนการเรียกผู้ให้บริการ AI พร้อมกันสูงสุด · รอคิวเกินงบเวลา → ตอบจากฐานความรู้
VORA_AI_CONCURRENCY=4
# (6E-1) ถ้าผู้ให้บริการบล็อก/ตัดคำตอบ/ตอบว่าง → ตอบจากฐานความรู้ทันที ไม่นับเป็นการล่ม ไม่ส่งต่อผู้ให้บริการสำรอง
# Phase 6 · 6D: ตอบคำถามความรู้ทั่วไป (ไม่ใช่เรื่องของวิทยาลัย) ด้วย LLM · ปิดเป็นค่าเริ่มต้น
# เปิดได้เมื่อเจ้าของโครงการอนุมัติเท่านั้น · คำถามเรื่องวิทยาลัยไม่ไปเส้นทางนี้ · คำถามไม่ปลอดภัยไม่ถูกส่งไปผู้ให้บริการ
VORA_AI_GENERAL_ENABLED=false
# ค้นข้อมูลจากอินเทอร์เน็ตเมื่อผู้ใช้ขอ ("หาข้อมูล … ให้หน่อย") ต้องใช้ผู้ให้บริการ gemini เพื่อค้น Google (ไม่มี = ใช้ Wikipedia)
VORA_AI_WEB_ENABLED=false
VORA_WEB_TIMEOUT=12
# โมเดลสำหรับค้นเว็บโดยเฉพาะ (ว่าง = ใช้ VORA_LLM_MODEL) เช่น gemini-3.5-flash ค้นได้ตรงกว่ารุ่น lite แต่ช้ากว่าเล็กน้อย
VORA_WEB_MODEL=
# จำกัดการเรียก AI ต่อนาที (ทุกงานรวมกัน) ให้ต่ำกว่าโควตา RPM ใน AI Studio · Gemini 3.5 Flash Lite ฟรี = 15 → ตั้ง 12 · 0 = ไม่จำกัด
VORA_LLM_RPM=0
# พิกัดสำหรับตอบสภาพอากาศแบบเรียลไทม์ (Open-Meteo ไม่ต้องใช้คีย์)
VORA_WEATHER_LAT=18.7756
VORA_WEATHER_LON=100.7730
VORA_WEATHER_PLACE_TH=จังหวัดน่าน
VORA_WEATHER_PLACE_EN=Nan
# ห้ามใส่คีย์จริงในไฟล์ตัวอย่างนี้ · คีย์อยู่ใน .env เท่านั้น และระบบไม่แสดงค่าคีย์ในหน้าจอ/บันทึกใด ๆ
# ความมั่นใจขั้นต่ำของการค้นคืน ถ้าต่ำกว่านี้หุ่นยนต์จะบอกว่าไม่มีข้อมูล (0.15-0.35)
VORA_RETRIEVAL_THRESHOLD=0.22

# ===== ความปลอดภัยของช่องทาง (Phase 6 · 6E-4) =====
# เครื่องที่ถือเป็นหน้าจอบนตัวหุ่นยนต์ (kiosk): ได้รับยกเว้น rate limit และสั่งท่าหุ่นยนต์ได้ — ตัดสินจาก IP ผู้เรียก
# ไม่เชื่อค่า channel ที่หน้าจอส่งมา · ค่าเริ่มต้น = เครื่องตัวเอง (kiosk.bat เปิด http://localhost:8000/)
# ถ้าเปิดหน้า kiosk จากเครื่องอื่นใน LAN ให้เพิ่ม IP ของเครื่องนั้น (คั่นด้วย ,) — ห้ามใส่ IP ของมือถือ/เครื่องสาธารณะ
VORA_KIOSK_TRUSTED_HOSTS=127.0.0.1,::1
# 25 พ.ย. 2569: จอในวง LAN ที่ผู้ดูแลอนุมัติ = สิทธิ์จอแสดงผล (ไม่สั่งหุ่นยนต์จริง) · 0 = ปิด
VORA_LAN_SCREENS=1
# https ให้เครื่องอื่นในวง LAN (ไมค์/กล้อง) — ใช้เมื่อรัน lan_setup.bat แล้ว · 0 = ปิด
VORA_HTTPS_PORT=8443
# server = ค่าเริ่มต้น · legacy = เชื่อ channel จาก client แบบก่อน 6E (ใช้เป็นทาง rollback ชั่วคราวเท่านั้น ไม่ปลอดภัย)
VORA_CHANNEL_TRUST=server

# ===== เสียงพูด =====
# edge = เสียงประจำตัว VORA (ผู้หญิง ไทยธรรมชาติ ต้องมีอินเทอร์เน็ต ไม่มีค่าใช้จ่าย ไม่ต้องใช้ API key)
#        เน็ตหลุด/ผู้ให้บริการล่ม → ใช้เสียงของเบราว์เซอร์อัตโนมัติ → ถ้าไม่มีเสียงเลยยังแสดงข้อความตามปกติ
# browser = เสียงของเบราว์เซอร์/Windows เท่านั้น (ออฟไลน์ได้ แต่ Chrome บน Windows มักมีแค่เสียงไทยผู้ชาย "Pattara")
VORA_TTS_PROVIDER=edge
VORA_TTS_VOICE_TH=th-TH-PremwadeeNeural
# same = ภาษาอังกฤษใช้เสียงเดียวกับภาษาไทย (VORA คนเดิมทุกภาษา) · ต้องการเสียงอังกฤษแยก ใส่ชื่อเสียง เช่น en-US-AvaNeural
VORA_TTS_VOICE_EN=same
# ความเร็ว -5% ≈ 0.95 เท่า · ระดับเสียง +0Hz (สูงเกิน +10Hz จะฟังเป็นเด็ก) · เวลาสร้างเสียงสูงสุดต่อประโยค (วินาที)
VORA_TTS_RATE=-5%
VORA_TTS_PITCH=+0Hz
VORA_TTS_TIMEOUT=8
# เสียงสำรองเมื่อ edge-tts ไม่ได้เสียง: none | google (เสียงผู้หญิงจาก Google Translate · ไม่เป็นทางการ) · ตรวจ/ตั้งค่าด้วย tts_doctor.bat
VORA_TTS_FALLBACK=none

# ---------- ทนเน็ตล่ม (งาน F "สาธิตไม่สะดุด" · 21 พ.ย. 2569 · docs/feature-F-offline-resilience.md) ----------
# ตรวจอินเทอร์เน็ตทุก N วินาที · เน็ตล่ม = โหมดฐานความรู้ (ตอบจากฐานความรู้ทันที + เสียงที่เตรียมไว้) · 0 = ปิดการตรวจ
VORA_NET_CHECK_S=15
# ที่อยู่สำหรับตรวจ (คั่นด้วย ,) — ได้คำตอบ HTTP ใด ๆ = ออนไลน์
VORA_NET_CHECK_URLS=https://www.gstatic.com/generate_204,https://www.google.com/generate_204

# ===== หุ่นยนต์ =====
# simulator = หุ่นจำลอง | serial = ต่อบอร์ดผ่าน USB | websocket = ต่อบอร์ดผ่าน Wi-Fi
VORA_ROBOT_DRIVER=simulator
VORA_ROBOT_SERIAL_PORT=COM3
VORA_ROBOT_SERIAL_BAUD=115200
VORA_ROBOT_WS_URL=ws://192.168.4.1:81/
VORA_ROBOT_HEARTBEAT_MS=300
VORA_ROBOT_ENABLE_MOTION=true

# ===== ประชาสัมพันธ์อัตโนมัติ =====
VORA_SCHEDULER=true
VORA_GREETING_COOLDOWN=25
VORA_IDLE_ATTRACT=90
VORA_MAX_ANNOUNCE_PER_HOUR=12

# งาน A "สมองโปร่งใส" (21 พ.ย. 2569): หน้าหลังบ้านแสดงขั้นตอนการคิดของ AI แบบสด
# 1 = เปิด (ค่าเริ่มต้น) · 0 = ปิด (คำตอบ/หน้าจอหุ่นยนต์ไม่เปลี่ยนไม่ว่าเปิดหรือปิด)
VORA_BRAIN_TRACE=1
# จำนวนคำถามล่าสุดที่เก็บไว้ในหน่วยความจำ (ไม่ลงฐานข้อมูล รีสตาร์ตแล้วหาย)
VORA_BRAIN_TRACE_KEEP=30

# 22 พ.ย. 2569: สวิตช์เลือกโมเดล AI ในหลังบ้าน (ปัญญาประดิษฐ์ → เลือกโมเดล AI)
# ใส่คีย์ของแต่ละเจ้าไว้ที่นี่ แล้วเลือกตัวที่จะใช้จากหลังบ้านได้ทันที (ไม่ต้องรีสตาร์ต · กด "โหลดคีย์จาก .env ใหม่")
# ไม่ใส่ก็ได้ — ระบบใช้ VORA_LLM_API_KEY ของผู้ให้บริการหลักเดิมให้อัตโนมัติ
# VORA_KEY_TYPHOON=      # ฟรี ไม่ต้องใช้บัตร: playground.opentyphoon.ai
# VORA_KEY_GEMINI=       # Google AI Studio (มีโควตาฟรี)
# VORA_KEY_OPENAI=
# VORA_KEY_ANTHROPIC=
# เปลี่ยนชื่อโมเดลเริ่มต้นของแต่ละเจ้า (ไม่ใส่ = ค่าเริ่มต้นของระบบ) เช่น
# VORA_MODEL_TYPHOON=typhoon-v2.5-30b-a3b-instruct
# VORA_MODEL_OLLAMA=qwen2.5:7b
# VORA_BASE_OLLAMA=http://localhost:11434/v1

# 22 พ.ย. 2569: ถามต่อจากคำถามก่อนหน้า ("ที่แพร่ล่ะ", "แล้วพรุ่งนี้ล่ะ", "แล้วไอทีล่ะ")
VORA_FOLLOWUP=1
# จำหัวข้อล่าสุดนานกี่วินาที (กันไม่ให้ต่อเรื่องของผู้ใช้คนก่อน)
VORA_FOLLOWUP_TTL_S=180
# ให้ AI ที่เลือกไว้ช่วยเขียนคำถามต่อใหม่เมื่อกฎไม่เข้าใจ ("อันนั้นอยู่ที่ไหน") · 0 = ใช้แต่กฎ (เร็วกว่า)
VORA_FOLLOWUP_LLM=1

# 25 พ.ย. 2569: คำถามตรงกับ FAQ ที่อนุมัติแล้ว → อ่านคำตอบเต็ม ไม่ให้ AI ย่อ (0 = แบบเดิม)
VORA_FAQ_FULL=1
